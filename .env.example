# These values are public because Vite embeds VITE_* variables in the browser bundle.
# Never put SURREAL_JWT_SECRET or any database password in this file.
VITE_SURREAL_ENDPOINT=__SURREAL_WEBSOCKET_ENDPOINT__
VITE_GOOGLE_CLIENT_ID=__GOOGLE_CLIENT_ID__
VITE_AUTH_BROKER_URL=__AUTH_WORKER_URL__
# SurrealDB is the default for development and production builds. Uncomment
# this only when you explicitly want to work with bundled mock packets.
# VITE_USE_MOCK_DATA=true
