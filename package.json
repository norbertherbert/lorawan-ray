{
  "name": "surrealdb-cloud-todo-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "worker:login": "wrangler login",
    "worker:secret": "wrangler secret put SURREAL_JWT_SECRET --config worker/wrangler.toml",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/sdbexample-worker --config worker/wrangler.toml"
  },
  "dependencies": {
    "jose": "^6.2.9",
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "vite": "^7.1.2",
    "wrangler": "^4.123.0"
  }
}
