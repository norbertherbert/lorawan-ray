{
  "name": "lora-manta-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --test",
    "preview": "vite preview",
    "worker:login": "wrangler login",
    "worker:secret": "wrangler secret put SURREAL_JWT_SECRET --config worker/wrangler.toml",
    "worker:google-client-id": "wrangler secret put GOOGLE_CLIENT_ID --config worker/wrangler.toml",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/sdbexample-worker --config worker/wrangler.toml"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "flowbite-react": "^0.12.17",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "flowbite-react": {
      "deepmerge-ts": "8.0.0"
    },
    "undici": "7.29.1"
  }
}
